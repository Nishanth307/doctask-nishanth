APP_NAME=DocTask
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://user:1234@localhost:5432/doctask

# Universal Model Pool (Cloud-Only, Ordered by Preference)
LLM_MODEL_POOL=gemini:gemini-2.5-flash,gemini:gemini-2.5-flash-lite,groq:llama-3.3-70b-versatile,openrouter:openrouter/free
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_MODEL_COOLDOWN_SECONDS=300
LLM_PROVIDER_MAX_RETRIES=2

# Provider Fallbacks (Legacy)
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=gemini,groq,openrouter
LLM_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_OPENROUTER_MODEL=openrouter/free

# Provider Credentials (Cloud Only)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Local/Dev Only
OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_MODEL=text-embedding-004

UPLOAD_DIRECTORY=storage/uploads
GENERATED_DIRECTORY=storage/generated

LOG_LEVEL=INFO
DOCTASK_WATCH_FOLDER=storage/watch