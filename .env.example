APP_NAME=DocTask
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://user:1234@localhost:5432/doctask

DEFAULT_LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-pro

GOOGLE_API_KEY=

OPENAI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_MODEL=text-embedding-004

UPLOAD_DIRECTORY=storage/uploads
GENERATED_DIRECTORY=storage/generated

LOG_LEVEL=INFO
DOCTASK_WATCH_FOLDER=storage/watch
LLM_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash
LLM_PRIMARY_MODEL=gemini-2.5-pro